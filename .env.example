# Copy to .env and fill in. .env is gitignored and must never be committed.

# Google Gemini API key (free tier) for hook generation and voiceover scripts: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot token for the approval card and failure alerts: created via @BotFather (format 123456:ABC-...). SETUP.md section 1
TELEGRAM_BOT_TOKEN=

# Numeric Telegram chat ID authorized for single-card approvals: retrieved from getUpdates after you message the bot
TELEGRAM_CHAT_ID=

# Instagram Professional / Business account ID (the IG user id, not the @handle): Graph API Explorer, me/accounts?fields=instagram_business_account. SETUP.md 2d
IG_USER_ID=

# Long-lived Meta PAGE access token (the Page's access_token from me/accounts, made from a long-lived user token; SETUP.md 2d)
# with all nine permissions: instagram_basic, instagram_content_publish, instagram_manage_insights, business_management,
# pages_show_list, pages_read_engagement, pages_manage_posts, read_insights, pages_manage_engagement.
# One such token covers Instagram AND Facebook Page Reels; scripts/cp3_dry_run.py fails if any permission is missing.
IG_ACCESS_TOKEN=

# Facebook Page ID that Page Reels are posted to: the Page's About tab, or me/accounts in the Graph API Explorer
FB_PAGE_ID=

# Optional, normally BLANK: a second PAGE token for the same Page, used only for Facebook Page Reels and their insights.
# It then needs pages_show_list, pages_read_engagement, pages_manage_posts, read_insights and pages_manage_engagement,
# and IG_ACCESS_TOKEN keeps the Instagram ones. Blank = posting uses IG_ACCESS_TOKEN, which must then carry all nine.
FB_PAGE_ACCESS_TOKEN=

# Healthchecks.io ping URL (dead-man switch: pinged after every fully successful runner cycle; unset = no ping): https://healthchecks.io
HEALTHCHECK_URL=

# Twitch Developer Application Client ID for Helix clips API (needed before 19 Nov 2026; no scopes): https://dev.twitch.tv/console, SETUP.md section 3
TWITCH_CLIENT_ID=

# Twitch Developer Application Client Secret for Helix app access token (needed before 19 Nov 2026)
TWITCH_CLIENT_SECRET=
