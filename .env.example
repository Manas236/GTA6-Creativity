# Copy to .env and fill in. .env is gitignored and must never be committed.

# Google Gemini API key (free tier) for hook generation and voiceover scripts: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot token for the approval card and failure alerts: created via @BotFather (format 123456:ABC-...)
TELEGRAM_BOT_TOKEN=

# Numeric Telegram chat ID authorized for single-card approvals: retrieved from getUpdates after you message the bot
TELEGRAM_CHAT_ID=

# Instagram Professional / Business account ID (the IG user id, not the @handle): Meta Graph API Explorer, me/accounts -> instagram_business_account
IG_USER_ID=

# Long-lived Meta PAGE access token with instagram_basic, instagram_content_publish, instagram_manage_insights and pages_read_engagement
IG_ACCESS_TOKEN=

# Facebook Page ID that Page Reels are posted to: the Page's About tab, or me/accounts in the Graph API Explorer
FB_PAGE_ID=

# Optional: separate PAGE access token for Facebook Page Reels, needing pages_show_list, pages_read_engagement and pages_manage_posts.
# Leave blank when IG_ACCESS_TOKEN is already a Page token for FB_PAGE_ID; posting falls back to it.
FB_PAGE_ACCESS_TOKEN=

# Healthchecks.io ping URL (dead-man switch pinged on each runner cycle, /fail on error): https://healthchecks.io
HEALTHCHECK_URL=

# Twitch Developer Application Client ID for Helix clips API (needed before 19 Nov 2026): https://dev.twitch.tv/console
TWITCH_CLIENT_ID=

# Twitch Developer Application Client Secret for Helix app access token (needed before 19 Nov 2026)
TWITCH_CLIENT_SECRET=
