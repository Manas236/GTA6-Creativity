# Google Gemini API key (free tier) for hook generation and voiceover scripts: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot token for review cards and failure alerts: created via @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric Telegram chat ID authorized for single-card approvals: retrieved from /getUpdates
TELEGRAM_CHAT_ID=

# Instagram Professional / Business account ID: retrieved via Meta Graph API explorer
IG_USER_ID=

# Long-lived Meta Page access token with instagram_content_publish and pages_manage_posts permissions
IG_ACCESS_TOKEN=

# Facebook Page ID for posting Reels to Facebook Page
FB_PAGE_ID=

# Healthchecks.io ping URL (dead-man switch pinged on each runner cycle, /fail on error): https://healthchecks.io
HEALTHCHECK_URL=

# Twitch Developer Application Client ID for Helix clips API (needed before 19 Nov 2026): https://dev.twitch.tv/console
TWITCH_CLIENT_ID=

# Twitch Developer Application Client Secret for Helix app access token (needed before 19 Nov 2026)
TWITCH_CLIENT_SECRET=

# Custom descriptive User-Agent header for public Reddit JSON requests to prevent HTTP 429 throttling
REDDIT_USER_AGENT=GTA6ClippingBot/1.0 (by /u/YourRedditUsername)
