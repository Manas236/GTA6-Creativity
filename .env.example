# Template for .env. You don't copy or edit this by hand: setup.bat runs scripts/env_wizard.py,
# which creates .env from this file and asks for each secret in the terminal (hidden input).
# .env is gitignored and must never be committed: this repository is public.
#
# Each variable has a tag line directly above it:
#   [required] / [optional]   whether the pipeline needs it (the dashboard itself needs none)
#   secret                    the wizard reads it without echoing
# The rest of that line says what it's for and where to get it. In .env: no quotes, no spaces
# around "=", no comments on the same line as a value.

# [required, secret] Gemini API key for hook generation and voiceover scripts (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# [required, secret] Telegram bot token for approval cards and alerts: @BotFather -> /newbot, format 123456:ABC-... (SETUP.md section 1)
TELEGRAM_BOT_TOKEN=

# [required] Your numeric Telegram chat ID: message the bot, then open api.telegram.org/bot<TOKEN>/getUpdates (SETUP.md section 1)
TELEGRAM_CHAT_ID=

# [required] Instagram business account ID (a long number, not the @handle): Graph API Explorer me/accounts (SETUP.md 2d)
IG_USER_ID=

# The Page's access_token from me/accounts, made from a long-lived user token, carrying all nine permissions:
# instagram_basic, instagram_content_publish, instagram_manage_insights, business_management, pages_show_list,
# pages_read_engagement, pages_manage_posts, read_insights, pages_manage_engagement. One token covers Instagram
# and Facebook Page Reels; scripts/cp3_dry_run.py fails if any permission is missing.
# [required, secret] Long-lived Meta PAGE access token with all nine permissions: Graph API Explorer me/accounts (SETUP.md 2d)
IG_ACCESS_TOKEN=

# [required] Facebook Page ID that Page Reels are posted to: Graph API Explorer me/accounts, the Page's "id" (SETUP.md 2d)
FB_PAGE_ID=

# [required, secret] Twitch app Client ID for the Helix clips API (needed before 19 Nov 2026): dev.twitch.tv/console (SETUP.md section 3)
TWITCH_CLIENT_ID=

# [required, secret] Twitch app Client Secret, shown once when you click New Secret: dev.twitch.tv/console (SETUP.md section 3)
TWITCH_CLIENT_SECRET=

# Only if you deliberately split the permissions over two Page tokens for the same Page: this one then needs
# pages_show_list, pages_read_engagement, pages_manage_posts, read_insights and pages_manage_engagement,
# and IG_ACCESS_TOKEN keeps the Instagram ones. Blank = posting uses IG_ACCESS_TOKEN for both platforms.
# [optional, secret] Second Meta PAGE token for Facebook Page Reels only; normally leave BLANK (SETUP.md 2d)
FB_PAGE_ACCESS_TOKEN=

# [optional, secret] Healthchecks.io ping URL, a dead-man switch pinged after each successful runner cycle: https://healthchecks.io
HEALTHCHECK_URL=

# [optional] Local port for the dashboard, read by setup.bat and start-dashboard.bat; change it only if 8765 is taken
DASHBOARD_PORT=8765

# Not read from this file (they only work as Windows environment variables, so they're not listed above):
#   GTA6_MEDIA_DIR  move the media/ folder (downloads, cuts, renders) somewhere else
#   HF_HOME         where faster-whisper caches its model; a stale value pointing at a missing drive is ignored
