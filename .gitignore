# Secrets
.env
.env.*
!.env.example

# Media and cache
media/
downloads/
renders/
cuts/
audio/
cache/
.cache/
assets/models/
*whisper*cache*
*.onnx
*.bin
*.mp4
*.mkv
*.webm
*.mov
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.opus
*.ogg
# yt-dlp partial downloads
*.part
*.ytdl
# fetched by scripts/fetch_assets.py (music bed + its generated LICENSES.md)
assets/music/

# ...but the committed style-layer SFX (A1, CC0, see assets/sfx/LICENSES.md) stay in.
# The CC0 music bed (A2) is NOT committed: scripts/fetch_assets.py downloads it.
!assets/sfx/*.wav

# Database & runtime state
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite*
*.lock

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
*.log
logs/


# Style-layer verification build output: only samples/synthetic/presets_sheet.png
# is committed (the renders themselves are mp4s and must not be in a public repo).
samples/synthetic/presets/
samples/synthetic/style_report.json

# Local dated backups (hold copies of .env, pipeline.db, configs)
backups/

# Windows / OneDrive folder metadata
desktop.ini
Thumbs.db
